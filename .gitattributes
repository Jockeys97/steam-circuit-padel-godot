# Binary game assets are versioned with Git LFS. Keep the patterns scoped to
# asset directories so screenshots, documentation and UI images stay normal Git.
godot/assets/**/*.glb filter=lfs diff=lfs merge=lfs -text
godot/assets/**/*.blend filter=lfs diff=lfs merge=lfs -text
godot/assets/**/*.fbx filter=lfs diff=lfs merge=lfs -text
godot/assets/**/*.png filter=lfs diff=lfs merge=lfs -text
godot/assets/**/*.jpg filter=lfs diff=lfs merge=lfs -text
godot/assets/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
godot/assets/**/*.webp filter=lfs diff=lfs merge=lfs -text
godot/assets/**/*.tga filter=lfs diff=lfs merge=lfs -text
godot/assets/**/*.tif filter=lfs diff=lfs merge=lfs -text
godot/assets/**/*.tiff filter=lfs diff=lfs merge=lfs -text
godot/assets/**/*.exr filter=lfs diff=lfs merge=lfs -text
godot/assets/**/*.wav filter=lfs diff=lfs merge=lfs -text
godot/assets/**/*.ogg filter=lfs diff=lfs merge=lfs -text
godot/assets/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
godot/assets/**/*.flac filter=lfs diff=lfs merge=lfs -text

