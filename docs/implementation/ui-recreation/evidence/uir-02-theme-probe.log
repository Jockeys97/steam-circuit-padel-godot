- Reference rules read line by line: `.btn` family `styles.css:244-278`, `.segmented` `:2207-2252`, `.screen-header` `:280-296`, cards `:323-342`, `.badge` `:119-132`, `.scoreboard` `:553-560`, `.hud-pause` (rule block after `:590`), `.pause-card` `:1100-1110`, `.game-hud__label` `:606`.

## Gaps this ticket did not close (all recorded in the token map §6)

Gradient fills render as their first measured stop (Godot styleboxes cannot hold a gradient together with a radius/shadow); one shadow per stylebox (the pause card's second cyan glow and the segmented container's inset shadow are not drawn); `backdrop-filter: blur(3px)` has no equivalent; CSS blur is mapped 1:1 to `shadow_size` (a mechanism, not a measured equivalence); `opacity: 0.4` on disabled buttons is emulated with alpha; fixed `width`/`height` rules become `custom_minimum_size` on the screen side. Each one names the trade so GATE-A can rule on it.

## Appendix: the static validator, verbatim

```python
#!/usr/bin/env python3
"""Static validation of UIR-02's artifacts. Read-only: reports, never edits.

Checks (each prints a line and a final tally):
  A. padel_theme.tres   — structure, load_steps, resource references, property keys
  B. token map equality — every README table row exists in the .tres with the same value
  C. theme_probe.tscn   — ext_resource paths, node parents, node types
  D. theme_probe.gd     — contract shape (extends SceneTree, tabs, quit, PASS line)
"""
import os, re, sys

REPO = "/Users/lucafantini/Desktop/Personal/Padel-3D/steam-circuit-padel-godot"
TRES = os.path.join(REPO, "godot/src/ui/theme/padel_theme.tres")
README = os.path.join(REPO, "godot/src/ui/theme/README.md")
TSCN = os.path.join(REPO, "godot/tests/ui/theme_probe.tscn")
PROBE = os.path.join(REPO, "godot/tests/ui/theme_probe.gd")

ok = 0
bad = 0


def check(name, cond, detail=""):
    global ok, bad
    if cond:
        ok += 1
        print(f"ok {name}" + (f" [{detail}]" if detail else ""))
    else:
        bad += 1
        print(f"FAIL {name}" + (f" — {detail}" if detail else ""))


def res_path(p):
    return os.path.join(REPO, "godot", p[len("res://"):])


def hex_to_rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


sections = {"colors", "constants", "fonts", "font_sizes", "icons", "styles", "base_type"}

# ---------------------------------------------------------------- A. .tres structure
tres = open(TRES, encoding="utf-8").read()
head = tres.splitlines()[0]
m = re.match(r'\[gd_resource type="Theme" load_steps=(\d+) format=3\]$', head)
check("A1 theme header is a Theme gd_resource", bool(m), head if not m else "")
ext = re.findall(r'\[ext_resource type="([^"]+)" path="([^"]+)" id="([^"]+)"\]', tres)
sub = re.findall(r'\[sub_resource type="([^"]+)" id="([^"]+)"\]', tres)
check("A2 at least one ext_resource", len(ext) > 0, f"{len(ext)} fonts")
missing = [p for _, p, _ in ext if not os.path.exists(res_path(p))]
check("A3 every ext_resource path exists on disk", not missing, ", ".join(missing))
ids = [i for _, i in sub]
check("A4 sub_resource ids are unique", len(ids) == len(set(ids)), f"{len(ids)} sub-resources")
refs = set(re.findall(r'SubResource\("([^"]+)"\)', tres))
undefined = sorted(refs - set(ids))
check("A5 every SubResource() reference resolves", not undefined, ", ".join(undefined))
declared = re.match(r'\[gd_resource type="Theme" load_steps=(\d+)', head)
expected_steps = len(ext) + len(sub) + 1
check("A6 load_steps equals ext + sub + 1", int(declared.group(1)) == expected_steps,
      f"header {declared.group(1)} vs computed {expected_steps}")

body = tres.split("[resource]", 1)[1]
props = re.findall(r'^([A-Za-z_][\w/]*)\s*=', body, re.M)
bad_keys = []
palette = {}
theme_sizes = {}
for key in props:
    if "/" not in key:
        continue
    parts = key.split("/")
    if len(parts) == 2 and parts[1] == "base_type":
        continue
    if len(parts) != 3 or parts[1] not in sections:
        bad_keys.append(key)
        continue
    if parts[0] == "Palette" and parts[1] == "colors":
        palette[parts[2]] = key
    if parts[1] == "font_sizes":
        mm = re.search(r'^%s = (\d+)$' % re.escape(key), body, re.M)
        theme_sizes.setdefault(parts[0], {})[parts[2]] = int(mm.group(1)) if mm else None
check("A7 every property key is Type/section/name with a known section", not bad_keys, ", ".join(bad_keys))
check("A8 the theme carries palette colours", len(palette) >= 40, f"{len(palette)} colours")
variations = sorted({p.split("/")[0] for p in props if "/" in p} - {"Palette", "Label", "Button", "Panel"})
check("A9 the theme declares variations", len(variations) >= 20, f"{len(variations)}: {', '.join(variations)}")

# ---------------------------------------------------------------- B. README map == .tres
readme = open(README, encoding="utf-8").read()

# B1: palette hex rows  | `token` | `#hex` | ...
rows = re.findall(r'^\| `([a-z0-9_]+)` \| ?`?#?([0-9a-fA-F]{6})`?', readme, re.M)
checked = 0
mismatch = []
for token, hexval in rows:
    if token not in palette:
        mismatch.append(f"{token}: not in theme palette")
        continue
    mm = re.search(r'^Palette/colors/%s = Color\(([^)]+)\)$' % re.escape(token), body, re.M)
    if not mm:
        mismatch.append(f"{token}: no Color() line")
        continue
    comps = [float(x) for x in mm.group(1).split(",")]
    got = tuple(round(c * 255) for c in comps[:3])
    if got != hex_to_rgb(hexval):
        mismatch.append(f"{token}: theme rgb{got} vs README #{hexval}")
    else:
        checked += 1
check("B1 every README palette hex equals the theme's colour", not mismatch,
      f"{checked} matched" + ("; " + "; ".join(mismatch) if mismatch else ""))

# B2: variation names
readme_variations = set(re.findall(r'^\| `([A-Za-z][A-Za-z0-9_]*)` \| `(?:Label|Button|Panel)`', readme, re.M))
missing_var = sorted(v for v in readme_variations if v not in variations)
check("B2 every variation in the README table exists in the theme", not missing_var, ", ".join(missing_var))
extra = sorted(v for v in variations if v not in readme_variations)
check("B3 every variation in the theme is documented in the README", not extra, ", ".join(extra))

# B4: font sizes
size_rows = re.findall(r'^\| `([A-Za-z][A-Za-z0-9_]*)` \|[^\n]*?\| (\d+) \*(?:[^|]*)\|', readme, re.M)
size_mismatch = []
for name, size in size_rows:
    got = theme_sizes.get(name, {}).get("font_size")
    if got is None:
        size_mismatch.append(f"{name}: no font_size in theme")
    elif int(size) != got:
        size_mismatch.append(f"{name}: README {size} vs theme {got}")
check("B4 every README font size equals the theme's integer size", not size_mismatch, "; ".join(size_mismatch))

# B5: fallback fonts declared on every role font
fvs = [l for l in tres.splitlines() if l.startswith("[sub_resource type=\"FontVariation\"")]
without = 0
for i, line in enumerate(tres.splitlines()):
    if line.startswith('[sub_resource type="FontVariation"'):
        block = tres.split(line, 1)[1].split("[sub_resource", 1)[0]
        if "fallbacks" not in block and "SystemFont_Mono" not in block:
            without += 1
check("B5 every role font declares fallbacks (except the mono/system base)", without <= 1, f"{without} without")

# ---------------------------------------------------------------- C. .tscn
tscn = open(TSCN, encoding="utf-8").read()
ext2 = re.findall(r'\[ext_resource type="([^"]+)" path="([^"]+)" id="([^"]+)"\]', tscn)
missing2 = [p for _, p, _ in ext2 if not os.path.exists(res_path(p))]
check("C1 every tscn ext_resource path exists", not missing2, ", ".join(missing2))
nodes = re.findall(r'\[node name="([^"]+)" type="([^"]+)"(?: parent="([^"]+)")?\]', tscn)
paths = {"."}
problems = []
for name, ntype, parent in nodes:
    if parent in (None, ""):
        paths.add(name)
        continue
    if parent != "." and parent not in paths:
        problems.append(f"{name}: parent '{parent}' not declared before it")
    paths.add((parent + "/" + name).lstrip("./"))
check("C2 every tscn node parent resolves to an earlier node", not problems, "; ".join(problems))
known = {"Control", "MarginContainer", "VBoxContainer", "HBoxContainer", "GridContainer", "Label", "Button", "PanelContainer", "Panel"}
unknown = sorted({t for _, t, _ in nodes} - known)
check("C3 every tscn node type is a Control class", not unknown, ", ".join(unknown))
check("C4 the tscn mounts the theme", 'theme = ExtResource("1_theme")' in tscn)
variations_in_scene = set(re.findall(r'theme_type_variation = &"([^"]+)"', tscn))
missing_scene = sorted(v for v in variations if v not in variations_in_scene and v != "Palette")
check("C5 the tscn mounts one instance of every variation", not missing_scene, ", ".join(missing_scene))

# ---------------------------------------------------------------- D. probe contract
probe = open(PROBE, encoding="utf-8").read()
check("D1 probe extends SceneTree", probe.startswith("##") and "\nextends SceneTree" in probe)
check("D2 probe prints the PASS/FAIL contract", 'print("PASS %d/%d"' in probe and 'print("FAIL %d/%d"' in probe)
check("D3 probe exits on both verdicts", "quit(0 if _failures == 0 else 1)" in probe)
space_lines = [i + 1 for i, l in enumerate(probe.splitlines()) if l.startswith(" ") and l.strip()]
check("D4 probe is tab-indented (no space-indented body lines)", not space_lines, str(space_lines[:5]))
paths_in_probe = re.findall(r'"(res://[^"]+)"', probe)
missing3 = [p for p in paths_in_probe if not os.path.exists(res_path(p))]
check("D5 every res:// path in the probe exists on disk", not missing3, ", ".join(missing3))
check("D6 probe drives the four ticket sizes",
      all(s in probe for s in ["1280, 720", "1152, 648", "1920, 1080", "1024, 600"]))

print()
print(f"{'PASS' if bad == 0 else 'FAIL'} {ok}/{ok + bad}")
sys.exit(0 if bad == 0 else 1)
```


