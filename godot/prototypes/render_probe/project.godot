; Offscreen render probe — proves (or disproves) that this GPU-less host can
; produce a real Godot-rendered PNG through Xvfb.
config_version=5

[application]

config/name="Render Probe"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
